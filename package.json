
{
  "name": "ted-education-mobile-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:unit": "vitest run --config vitest.config.mts src/",
    "test:integration": "vitest run --config vitest.config.mts test/integration/",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:e2e:vitest": "vitest run --config vitest.config.mts test/",
    "test:security": "vitest run --config vitest.config.mts test/security.e2e-spec.ts",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:debug:vitest": "vitest --config vitest.config.mts --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "expo": "~57.0.28",
    "helmet": "^8.3.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.4",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "jest": "~29.7.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
