
# TED Education API - Example Environment Configuration
#
# Copy this file to .env.local for local development.
# Never commit real API keys or secrets.

# Application environment
# Supported: development, test, production
NODE_ENV=development

# Server port (optional; defaults to 3000)
PORT=3000

# Observe configuration (required)
# Replace with your real credentials in .env.local
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# CORS configuration
# Comma-separated list of allowed origins
# Production origins must use HTTPS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# API rate limiting
# TTL is measured in milliseconds
API_RATE_LIMIT_TTL=60000
API_RATE_LIMIT_MAX=100

# Maximum HTTP request body size
REQUEST_BODY_LIMIT=100kb
